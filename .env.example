# Copy to .env and adjust. Everything is optional for a local run.

# OpenAlex API key (free). Only needed to harvest fresh data; the bundled snapshot in
# data/works.jsonl.gz is used when the database is empty.
OPENALEX_API_KEY=

# Number of works to harvest.
HARVEST_LIMIT=1000

# Host port for the web app.
WEB_PORT=8080

# Change for anything that isn't a local demo.
POSTGRES_PASSWORD=openalex
